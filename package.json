{
  "name": "clockapp",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "electron/main.js",
  "repository": "https://github.com/PietroFilippo/ClockApp",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite build --watch\" \"electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:publish": "vite build && electron-builder --publish always"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.6.0",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.pietrofilippo.clockapp",
    "productName": "Clock App",
    "publish": {
      "provider": "github",
      "owner": "PietroFilippo",
      "repo": "ClockApp"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "electron-updater": "^6.7.3"
  }
}
